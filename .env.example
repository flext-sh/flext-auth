# FLEXT Authentication API - Environment Configuration

# Application Configuration
APP_NAME="FLEXT Authentication API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Production-ready authentication service for FLEXT"
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=false
DEBUG=false
LOG_LEVEL=info
TRUSTED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/flext_auth
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=10
DB_COMMAND_TIMEOUT=60

# JWT Configuration (CRITICAL: Change in production!)
JWT_SECRET_KEY=generate-a-secure-random-key-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Security Configuration
PASSWORD_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_EXPIRE_HOURS=24
MAX_CONCURRENT_SESSIONS=5
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_2FA=false

# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
LOGIN_RATE_LIMIT_PER_MINUTE=5
REGISTER_RATE_LIMIT_PER_MINUTE=3

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
