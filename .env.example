# FLEXT Authentication API - Environment Configuration

APP_DESCRIPTION="Production-ready authentication service for FLEXT"
# Application Configuration
APP_NAME="FLEXT Authentication API"
APP_VERSION=1.0.0
ENVIRONMENT=development

DEBUG=false
# Server Configuration
HOST=0.0.0.0
LOG_LEVEL=info
PORT=8000
RELOAD=false
TRUSTED_HOSTS=localhost,127.0.0.1
WORKERS=1

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/flext_auth
DB_COMMAND_TIMEOUT=60
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=1

JWT_ACCESS_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_EXPIRE_DAYS=7
# JWT Configuration (CRITICAL: Change in production!)
JWT_SECRET_KEY=generate-a-secure-random-key-minimum-32-chars

ENABLE_2FA=false
LOCKOUT_DURATION_MINUTES=30
MAX_CONCURRENT_SESSIONS=5
MAX_FAILED_ATTEMPTS=5
# Security Configuration
PASSWORD_ROUNDS=12
REQUIRE_EMAIL_VERIFICATION=false
SESSION_EXPIRE_HOURS=24

LOGIN_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=1000
# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60
REGISTER_RATE_LIMIT_PER_MINUTE=3

CORS_ALLOWED_HEADERS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=true
# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
