# FLEXT Auth Service Configuration
# Copy this to .env and customize for your environment

DEBUG=true
# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_SECRET_KEY=your-jwt-secret-key-here
# Security Configuration
SECRET_KEY=your-auth-secret-key-minimum-32-characters

BCRYPT_ROUNDS=12
# Password Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
PASSWORD_REQUIRE_UPPERCASE=true

DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_SIZE=20
# Database
DATABASE_URL=postgresql://flext:password@localhost:5432/flext_auth

# Redis for Sessions & Tokens
REDIS_URL=redis://localhost:6379/4
SESSION_TIMEOUT=3600
TOKEN_BLACKLIST_TIMEOUT=86400

RATE_LIMIT_API_CALLS=100
# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=300

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration
EMAIL_BACKEND=console
EMAIL_FROM=noreply@flext.dev
SMTP_HOST=localhost
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USER=
SMTP_USE_TLS=true

# Password Reset
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_URL_TEMPLATE=http://localhost:8080/auth/reset/{token}

# Account Verification
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TIMEOUT=86400

# Multi-Factor Authentication
MFA_ENABLED=false
MFA_ISSUER_NAME=FLEXT
TOTP_VALIDITY_WINDOW=1

SESSION_COOKIE_HTTPONLY=true
# Session Configuration
SESSION_COOKIE_NAME=flext_session
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

METRICS_PORT=9092
# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=
