    async def test_create_session_success(
        self,
        session_service: SessionService,
        mock_session_repository: MagicMock,
        mock_session_generator: MagicMock,
        mock_event_bus: MagicMock,
    ) -> None:
        """Test successful session creation."""
        # Setup mocks
        user_id = uuid4()
        username = Username(value="testuser")
        duration = timedelta(hours=1)
        session_id = "generated_session_id"

        mock_session_generator.generate_session_id = MagicMock(return_value=session_id)

        # Create expected session
        expected_session = Session(
            user_id=user_id,
            session_token=session_id,
            expires_at=datetime.now(UTC) + duration,
        )
        mock_session_repository.save = AsyncMock(
            return_value=ServiceResult.success(expected_session),
        )
        mock_event_bus.publish = AsyncMock()

        # Test session creation
        result = await session_service.create_session(
            user_id=user_id,
            username=username,
            duration=duration,
        )

        # Verify result
        assert result.is_success

        # Verify method calls
        mock_session_generator.generate_session_id.assert_called_once()
        mock_session_repository.save.assert_called_once()
        mock_event_bus.publish.assert_called_once()

    async def test_validate_session_success(
        self,
        session_service: SessionService,
        mock_session_repository: MagicMock,
    ) -> None:
        """Test successful session validation."""
        # Setup mocks
        session_id = "valid_session_id"
        session = Session(
            user_id=uuid4(),
            session_token=session_id,
            expires_at=datetime.now(UTC) + timedelta(hours=1),
        )
        session.is_valid = True

        mock_session_repository.get_by_token = AsyncMock(
            return_value=ServiceResult.success(session),
        )
        mock_session_repository.update = AsyncMock(
            return_value=ServiceResult.success(session),
        )

        # Test session validation
        result = await session_service.validate_session(session_id)

        # Verify result
        assert result.is_success
        assert result.value == session

        # Verify method calls
        mock_session_repository.get_by_token.assert_called_once_with(session_id)
        mock_session_repository.update.assert_called_once_with(session)

    async def test_validate_session_not_found(
        self,
        session_service: SessionService,
        mock_session_repository: MagicMock,
    ) -> None:
        """Test session validation with session not found."""
        # Setup mocks
        session_id = "invalid_session_id"
        mock_session_repository.get_by_token = AsyncMock(
            return_value=ServiceResult.failure("Session not found"),
        )

        # Test session validation
        result = await session_service.validate_session(session_id)

        # Verify result
        assert result.is_failure
        assert "Invalid session" in result.error_message

    async def test_refresh_session_success(
        self,
        session_service: SessionService,
        mock_session_repository: MagicMock,
    ) -> None:
        """Test successful session refresh."""
        # Setup mocks
        session_id = "session_id"
        duration = timedelta(hours=2)
        session = Session(
            user_id=uuid4(),
            session_token=session_id,
            expires_at=datetime.now(UTC) + timedelta(hours=1),
        )
        session.refresh = MagicMock()

        mock_session_repository.get_by_token = AsyncMock(
            return_value=ServiceResult.success(session),
        )
        mock_session_repository.update = AsyncMock(
            return_value=ServiceResult.success(session),
        )

        # Test session refresh
        result = await session_service.refresh_session(session_id, duration)

        # Verify result
        assert result.is_success
        assert result.value == session

        # Verify method calls
        mock_session_repository.get_by_token.assert_called_once_with(session_id)
        session.refresh.assert_called_once_with(duration)
        mock_session_repository.update.assert_called_once_with(session)


class TestServiceIntegration:
    """Test integration between services."""

    async def test_full_authentication_flow(self) -> None:
        """Test complete authentication flow integration."""
        # Create mocked dependencies
        mock_user_repo = MagicMock()
        mock_token_repo = MagicMock()
        mock_session_repo = MagicMock()
        mock_password_hasher = MagicMock()
        mock_token_generator = MagicMock()
        mock_session_generator = MagicMock()
        mock_event_bus = MagicMock()

        # Create services
        auth_service = AuthService(
            user_repository=mock_user_repo,
            token_repository=mock_token_repo,
            session_repository=mock_session_repo,
            password_hasher=mock_password_hasher,
            token_generator=mock_token_generator,
            event_bus=mock_event_bus,
        )

        session_service = SessionService(
            session_repository=mock_session_repo,
            session_generator=mock_session_generator,
            event_bus=mock_event_bus,
        )

        token_service = TokenService(
            token_repository=mock_token_repo,
            token_generator=mock_token_generator,
            event_bus=mock_event_bus,
        )

        # Create test user
        user = User(
            username="testuser",
            email="test@example.com",
            password_hash="hash",
            status="active",  # Set status to active so is_active() returns True
            locked_until=None,  # Explicitly ensure user is not locked
            login_attempts=0,  # Reset login attempts
        )
        # Mock the actual password verification by replacing the hash
        original_password_hash = user.password_hash
        user.password_hash = "mock_hash"

        # Setup mocks for authentication
        username = Username(value="testuser")
        mock_user_repo.get_by_username = AsyncMock(
            return_value=ServiceResult.success(user),
        )
        mock_user_repo.update = AsyncMock(return_value=ServiceResult.success(user))
        mock_event_bus.publish = AsyncMock()

        # 1. Authenticate user
        auth_result = await auth_service.authenticate_user(
            username=username,
            password="password",
        )
        if not auth_result.is_success:
            print(f"Authentication failed: {auth_result.error}")
        assert auth_result.is_success

        # 2. Create session for authenticated user
        mock_session_generator.generate_session_id = MagicMock(return_value="session_id")
        session = Session(
            user_id=user.id,
            session_token="session_id",
            expires_at=datetime.now(UTC) + timedelta(hours=1),
        )
        mock_session_repo.save = AsyncMock(return_value=ServiceResult.success(session))

        session_result = await session_service.create_session(
            user_id=user.id,
            username=username,
            duration=timedelta(hours=1),
        )
        assert session_result.is_success

        # 3. Create token for authenticated user
        mock_token_generator.generate_token = MagicMock(return_value="token_value")
        token = AuthToken(value="token_value", token_type="access")
        mock_token_repo.save = AsyncMock(return_value=ServiceResult.success(token))

        token_result = await token_service.create_token(
            user_id=user.id,
            username=username,
            token_type="access",
            expires_in=timedelta(hours=1),
        )
        assert token_result.is_success

        # Verify all operations completed successfully
        assert all([
            auth_result.is_success,
            session_result.is_success,
            token_result.is_success,
        ])
