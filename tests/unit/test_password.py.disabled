from __future__ import annotations

import pytest

from flext_auth import FlextPasswordService
from flext_auth.constants import FlextAuthConstants


class TestFlextPasswordService:
    """Unit tests for FlextPasswordService class."""

    def test_password_service_initialization(self) -> None:
        """Test password service initialization."""
        service = FlextPasswordService()
        assert service is not None

    def test_hash_password_success(self) -> None:
        """Test successful password hashing."""
        service = FlextPasswordService()
        password = "TestPassword123!"

        result = service.hash_password(password)
        assert result.success

        password_hash = result.value
        assert password_hash.startswith("$2b$")
        assert len(password_hash) > 50

    def test_hash_password_with_custom_rounds(self) -> None:
        """Test password hashing with custom rounds."""
        service = FlextPasswordService()
        password = "TestPassword123!"
        custom_rounds = 10

        result = service.hash_password(password, custom_rounds)
        assert result.success

        password_hash = result.value
        assert password_hash.startswith("$2b$10$")  # Should use custom rounds

    def test_hash_password_with_none_rounds(self) -> None:
        """Test password hashing with None rounds (uses default)."""
        service = FlextPasswordService()
        password = "TestPassword123!"

        result = service.hash_password(password, None)
        assert result.success

        password_hash = result.value
        assert password_hash.startswith("$2b$")

    def test_verify_password_correct(self) -> None:
        """Test password verification with correct password."""
        service = FlextPasswordService()
        password = "TestPassword123!"

        # Hash the password first
        hash_result = service.hash_password(password)
        assert hash_result.success
        password_hash = hash_result.value

        # Verify with correct password
        verify_result = service.verify_password(password, password_hash)
        assert verify_result.success
        assert verify_result.value is True

    def test_verify_password_incorrect(self) -> None:
        """Test password verification with incorrect password."""
        service = FlextPasswordService()
        password = "TestPassword123!"
        wrong_password = "WrongPassword123!"

        # Hash the original password
        hash_result = service.hash_password(password)
        assert hash_result.success
        password_hash = hash_result.value

        # Verify with wrong password
        verify_result = service.verify_password(wrong_password, password_hash)
        assert verify_result.success
        assert verify_result.value is False

    def test_validate_password_strength_strong(self) -> None:
        """Test password strength validation with strong password."""
        service = FlextPasswordService()
        strong_password = "StrongPassword123!"

        result = service.validate_password_strength(strong_password)
        assert result.success

    def test_validate_password_strength_weak_too_short(self) -> None:
        """Test password strength validation with too short password."""
        service = FlextPasswordService()
        short_password = "Short1!"

        result = service.validate_password_strength(short_password)
        assert result.is_failure

    def test_validate_password_strength_weak_no_uppercase(self) -> None:
        """Test password strength validation with no uppercase letters."""
        service = FlextPasswordService()
        no_upper_password = "lowercase123!"

        result = service.validate_password_strength(no_upper_password)
        assert result.is_failure

    def test_validate_password_strength_weak_no_lowercase(self) -> None:
        """Test password strength validation with no lowercase letters."""
        service = FlextPasswordService()
        no_lower_password = "UPPERCASE123!"

        result = service.validate_password_strength(no_lower_password)
        assert result.is_failure

    def test_validate_password_strength_weak_no_numbers(self) -> None:
        """Test password strength validation with no numbers."""
        service = FlextPasswordService()
        no_numbers_password = "NoNumbersPassword!"

        result = service.validate_password_strength(no_numbers_password)
        assert result.is_failure

    def test_validate_password_strength_weak_no_special(self) -> None:
        """Test password strength validation with no special characters."""
        service = FlextPasswordService()
        no_special_password = "NoSpecialPassword123"

        result = service.validate_password_strength(no_special_password)
        assert result.is_failure

    def test_validate_password_strength_empty(self) -> None:
        """Test password strength validation with empty password."""
        service = FlextPasswordService()
        empty_password = ""

        result = service.validate_password_strength(empty_password)
        assert result.is_failure

    def test_validate_password_strength_minimum_requirements(self) -> None:
        """Test password that barely meets minimum requirements."""
        service = FlextPasswordService()
        # 8 characters, has upper, lower, number, special
        minimal_password = "Abcd123!"

        result = service.validate_password_strength(minimal_password)
        assert result.success


class TestPasswordServiceIntegration:
    """Integration tests for password service operations."""

    def test_full_password_lifecycle(self) -> None:
        """Test complete password lifecycle: validate, hash, verify."""
        service = FlextPasswordService()
        password = "CompleteLifecycle123!"

        # 1. Validate password strength
        strength_result = service.validate_password_strength(password)
        assert strength_result.success

        # 2. Hash the password
        hash_result = service.hash_password(password)
        assert hash_result.success
        hashed = hash_result.value
        assert len(hashed) > 50

        # 3. Verify the password
        verification_result = service.verify_password(password, hashed)
        assert verification_result.success
        assert verification_result.value is True

        # 4. Verify with wrong password
        wrong_verification_result = service.verify_password("WrongPassword123!", hashed)
        assert wrong_verification_result.success
        assert wrong_verification_result.value is False

    def test_multiple_hashes_different(self) -> None:
        """Test that multiple hashes of same password are different (due to salt)."""
        service = FlextPasswordService()
        password = "TestPassword123!"

        hash1_result = service.hash_password(password)
        hash2_result = service.hash_password(password)
        assert hash1_result.success
        assert hash2_result.success

        hash1 = hash1_result.value
        hash2 = hash2_result.value

        # Hashes should be different due to different salts
        assert hash1 != hash2

        # But both should verify correctly
        verify1_result = service.verify_password(password, hash1)
        verify2_result = service.verify_password(password, hash2)
        assert verify1_result.success
        assert verify1_result.value is True
        assert verify2_result.success
        assert verify2_result.value is True

    def test_password_roundtrip_with_service(self) -> None:
        """Test password operations using service class directly."""
        service = FlextPasswordService()
        password = "ServiceTestPassword123!"

        # Hash using service
        hash_result = service.hash_password(password)
        assert hash_result.success
        hashed = hash_result.value

        # Verify using service
        verify_result = service.verify_password(password, hashed)
        assert verify_result.success
        assert verify_result.value is True

        # Validate strength using service
        strength_result = service.validate_password_strength(password)
        assert strength_result.success

    def test_edge_case_passwords(self) -> None:
        """Test edge cases for password operations."""
        edge_cases = [
            "12345678",  # Only numbers, minimum length
            "abcdefgh",  # Only lowercase, minimum length
            "ABCDEFGH",  # Only uppercase, minimum length
            "!@#$%^&*",  # Only special chars, minimum length
        ]

        service = FlextPasswordService()
        for password in edge_cases:
            # These should all fail strength validation
            strength_result = service.validate_password_strength(password)
            assert strength_result.is_failure, (
                f"Password '{password}' should fail strength validation"
            )

            # But they should still hash and verify correctly
            try:
                hash_result = service.hash_password(password)
                assert hash_result.success
                hashed = hash_result.value
                verify_result = service.verify_password(password, hashed)
                assert verify_result.success
                assert verify_result.value is True
            except Exception as e:
                pytest.fail(
                    f"Password '{password}' should hash and verify correctly: {e}"
                )

    def test_long_password(self) -> None:
        """Test with very long password."""
        service = FlextPasswordService()
        # Create a long but valid password
        long_password = "A1!" + "a" * 120  # 123 characters total (within limit)

        # Should pass strength validation (has all required elements)
        strength_result = service.validate_password_strength(long_password)
        assert strength_result.success

        # Should hash and verify correctly
        hash_result = service.hash_password(long_password)
        assert hash_result.success
        hashed = hash_result.value
        verify_result = service.verify_password(long_password, hashed)
        assert verify_result.success
        assert verify_result.value is True

    def test_unicode_password(self) -> None:
        """Test with unicode characters in password."""
        service = FlextPasswordService()
        unicode_password = "Ünïcødé123!Pāssword"

        # Should hash and verify correctly
        hash_result = service.hash_password(unicode_password)
        assert hash_result.success
        hashed = hash_result.value

        verify_result = service.verify_password(unicode_password, hashed)
        assert verify_result.success
        assert verify_result.value is True

        # Should fail verification with wrong unicode
        wrong_unicode = "Únícôdê123!Password"
        wrong_verify_result = service.verify_password(wrong_unicode, hashed)
        assert wrong_verify_result.success
        assert wrong_verify_result.value is False


class TestPasswordServiceConstants:
    """Unit tests for password service constants and configuration."""

    def test_default_rounds_constant(self) -> None:
        """Test that default rounds constant is reasonable."""
        assert FlextPasswordService.DEFAULT_ROUNDS >= 10
        assert FlextPasswordService.DEFAULT_ROUNDS <= 15  # Not too slow for testing

    def test_password_validation_constants(self) -> None:
        """Test password validation constants are reasonable."""
        assert FlextAuthConstants.MIN_PASSWORD_LENGTH >= 8
        assert FlextAuthConstants.MAX_PASSWORD_LENGTH >= 128
        assert (
            FlextAuthConstants.MIN_PASSWORD_LENGTH
            <= FlextAuthConstants.MAX_PASSWORD_LENGTH
        )
