class TestPasswordHasherImpl:
    """Test PasswordHasherImpl functionality."""

    @pytest.fixture
    def mock_settings(self) -> MagicMock:
        """Create mock settings for testing."""
        settings = MagicMock()
        settings.password.bcrypt_rounds = 12
        return settings

    @pytest.fixture
    def password_hasher(self, mock_settings: MagicMock) -> PasswordHasherImpl:
        """Create PasswordHasherImpl for testing."""
        return PasswordHasherImpl(mock_settings)

    def test_password_hasher_initialization(self, mock_settings: MagicMock) -> None:
        """Test PasswordHasherImpl initialization."""
        hasher = PasswordHasherImpl(mock_settings)

        assert hasher.settings == mock_settings
        assert hasher.context is not None

    def test_password_hasher_initialization_default_settings(self) -> None:
        """Test PasswordHasherImpl initialization with default settings."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.bcrypt_rounds = 10
            mock_get_settings.return_value = mock_settings

            hasher = PasswordHasherImpl()

            assert hasher.settings == mock_settings
            mock_get_settings.assert_called_once()

    def test_hash_password(self, password_hasher: PasswordHasherImpl) -> None:
        """Test password hashing."""
        password = "test_password_123"
        hashed = password_hasher.hash_password(password)

        assert hashed != password
        assert len(hashed) > 0
        assert hashed.startswith("$2b$")

    def test_verify_password_correct(self, password_hasher: PasswordHasherImpl) -> None:
        """Test password verification with correct password."""
        password = "test_password_123"
        hashed = password_hasher.hash_password(password)

        assert password_hasher.verify_password(password, hashed)

    def test_verify_password_incorrect(self, password_hasher: PasswordHasherImpl) -> None:
        """Test password verification with incorrect password."""
        password = "test_password_123"
        wrong_password = "wrong_password"
        hashed = password_hasher.hash_password(password)

        assert not password_hasher.verify_password(wrong_password, hashed)

    def test_needs_update(self, password_hasher: PasswordHasherImpl) -> None:
        """Test checking if password hash needs update."""
        password = "test_password_123"
        hashed = password_hasher.hash_password(password)

        # Fresh hash should not need update
        assert not password_hasher.needs_update(hashed)

    def test_hash_password_none_result(self, password_hasher: PasswordHasherImpl) -> None:
        """Test hash_password when context returns None."""
        with patch.object(password_hasher.context, "hash", return_value=None):
            result = password_hasher.hash_password("password")
            assert result == ""

    def test_verify_password_none_result(self, password_hasher: PasswordHasherImpl) -> None:
        """Test verify_password when context returns None."""
        with patch.object(password_hasher.context, "verify", return_value=None):
            result = password_hasher.verify_password("password", "hash")
            assert result is False

    def test_needs_update_none_result(self, password_hasher: PasswordHasherImpl) -> None:
        """Test needs_update when context returns None."""
        with patch.object(password_hasher.context, "needs_update", return_value=None):
            result = password_hasher.needs_update("hash")
            assert result is True


class TestUserCreationRequest:
    """Test UserCreationRequest validation and functionality."""

    def test_user_creation_request_valid(self) -> None:
        """Test valid UserCreationRequest creation."""
        request = UserCreationRequest(
            email="test@example.com",
            password="SecurePass123!",
            first_name="John",
            last_name="Doe",
            roles=["user", "REDACTED_LDAP_BIND_PASSWORD"],
        )

        assert request.email == "test@example.com"
        assert request.password == "SecurePass123!"
        assert request.first_name == "John"
        assert request.last_name == "Doe"
        assert request.roles == ["user", "REDACTED_LDAP_BIND_PASSWORD"]

    def test_user_creation_request_defaults(self) -> None:
        """Test UserCreationRequest with default values."""
        request = UserCreationRequest(
            email="test@example.com",
            password="SecurePass123!",
            first_name="John",
            last_name="Doe",
        )

        assert request.roles == []

    def test_user_creation_request_email_normalization(self) -> None:
        """Test email normalization in UserCreationRequest."""
        request = UserCreationRequest(
            email="  TEST@EXAMPLE.COM  ",
            password="SecurePass123!",
            first_name="John",
            last_name="Doe",
        )

        assert request.email == "test@example.com"

    def test_user_creation_request_password_validation_short(self) -> None:
        """Test password validation for too short password."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.min_length = 10
            mock_settings.password.require_uppercase = False
            mock_settings.password.require_lowercase = False
            mock_settings.password.require_numbers = False
            mock_settings.password.require_special = False
            mock_get_settings.return_value = mock_settings

            with pytest.raises(ValidationError) as exc_info:
                UserCreationRequest(
                    email="test@example.com",
                    password="short",
                    first_name="John",
                    last_name="Doe",
                )

            assert "at least" in str(exc_info.value) and "characters" in str(exc_info.value)

    def test_user_creation_request_password_validation_uppercase(self) -> None:
        """Test password validation for missing uppercase."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.min_length = 8
            mock_settings.password.require_uppercase = True
            mock_settings.password.require_lowercase = False
            mock_settings.password.require_numbers = False
            mock_settings.password.require_special = False
            mock_get_settings.return_value = mock_settings

            with pytest.raises(ValidationError) as exc_info:
                UserCreationRequest(
                    email="test@example.com",
                    password="lowercase123",
                    first_name="John",
                    last_name="Doe",
                )

            assert "Password must contain uppercase letters" in str(exc_info.value)

    def test_user_creation_request_password_validation_lowercase(self) -> None:
        """Test password validation for missing lowercase."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.min_length = 8
            mock_settings.password.require_uppercase = False
            mock_settings.password.require_lowercase = True
            mock_settings.password.require_numbers = False
            mock_settings.password.require_special = False
            mock_get_settings.return_value = mock_settings

            with pytest.raises(ValidationError) as exc_info:
                UserCreationRequest(
                    email="test@example.com",
                    password="UPPERCASE123",
                    first_name="John",
                    last_name="Doe",
                )

            assert "Password must contain lowercase letters" in str(exc_info.value)

    def test_user_creation_request_password_validation_numbers(self) -> None:
        """Test password validation for missing numbers."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.min_length = 8
            mock_settings.password.require_uppercase = False
            mock_settings.password.require_lowercase = False
            mock_settings.password.require_numbers = True
            mock_settings.password.require_special = False
            mock_get_settings.return_value = mock_settings

            with pytest.raises(ValidationError) as exc_info:
                UserCreationRequest(
                    email="test@example.com",
                    password="NoNumbers",
                    first_name="John",
                    last_name="Doe",
                )

            assert "Password must contain digits" in str(exc_info.value)

    def test_user_creation_request_password_validation_special(self) -> None:
        """Test password validation for missing special characters."""
        with patch("flext_auth.user_service.get_auth_settings") as mock_get_settings:
            mock_settings = MagicMock()
            mock_settings.password.min_length = 8
            mock_settings.password.require_uppercase = False
            mock_settings.password.require_lowercase = False
            mock_settings.password.require_numbers = False
            mock_settings.password.require_special = True
            mock_get_settings.return_value = mock_settings

            with pytest.raises(ValidationError) as exc_info:
                UserCreationRequest(
                    email="test@example.com",
                    password="NoSpecial123",
                    first_name="John",
                    last_name="Doe",
                )

            assert "Password must contain special characters" in str(exc_info.value)

    def test_user_creation_request_field_validations(self) -> None:
        """Test field length validations."""
        # Test minimum lengths
        with pytest.raises(ValidationError):
            UserCreationRequest(
                email="test@example.com",
                password="ValidPass123!",
                first_name="",  # Too short
                last_name="Doe",
            )

        with pytest.raises(ValidationError):
            UserCreationRequest(
                email="test@example.com",
                password="ValidPass123!",
                first_name="John",
                last_name="",  # Too short
            )

        # Test maximum lengths
        with pytest.raises(ValidationError):
            UserCreationRequest(
                email="test@example.com",
                password="ValidPass123!",
                first_name="A" * 51,  # Too long
                last_name="Doe",
            )


