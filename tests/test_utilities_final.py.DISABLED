            last_login=None,
        )

        result = FlextAuthUtilities.RoleValidation.get_user_permissions(user)
        assert result.is_success
        assert isinstance(result.data, set)

    def test_integration_complete_auth_flow(self) -> None:
        """Test complete authentication flow integration."""
        # 1. Generate a secure password
        password_result = (
            FlextAuthUtilities.PasswordUtilities.generate_secure_password()
        )
        assert password_result.is_success
        password = password_result.data

        # 2. Hash the password using bcrypt
        hash_result = FlextAuthUtilities.PasswordUtilities.hash_password_bcrypt(
            password
        )
        assert hash_result.is_success
        hashed_password = hash_result.data

        # 3. Verify the password
        verify_result = FlextAuthUtilities.PasswordUtilities.verify_password_bcrypt(
            password, hashed_password
        )
        assert verify_result.is_success
        assert verify_result.data is True

        # 4. Create a JWT token
        payload: dict[str, str] = {"sub": "user123", "role": "REDACTED_LDAP_BIND_PASSWORD"}
        secret = SecretStr("test_secret")

        jwt_result = FlextAuthUtilities.JWTProcessing.create_jwt_token(payload, secret)
        assert jwt_result.is_success
        token = jwt_result.data  # Direct string, not dict

        # 5. Extract claims from the token
        claims_result = FlextAuthUtilities.JWTProcessing.extract_claims(token, secret)
        assert claims_result is not None

        # 6. Create a session
        session_result = FlextAuthUtilities.SessionManagement.create_session("user123")
        assert session_result.is_success

        # 7. Generate OAuth state parameter
        state_result = FlextAuthUtilities.OAuthHelpers.generate_state_parameter()
        assert state_result.is_success

        # 8. Validate the state parameter
        validate_state_result = (
            FlextAuthUtilities.OAuthHelpers.validate_state_parameter(
                state_result.data, state_result.data
            )
        )
        assert validate_state_result.is_success

    def test_edge_cases_empty_inputs(self) -> None:
        """Test edge cases with empty inputs."""
        # Test with empty password
        empty_password = SecretStr("")
        result = FlextAuthUtilities.PasswordUtilities.hash_password(empty_password)
        assert result.is_success

        # Test with empty state parameter - should fail
        result = FlextAuthUtilities.OAuthHelpers.validate_state_parameter("", "")
        assert result.is_failure  # This should fail for empty strings

    def test_edge_cases_invalid_inputs(self) -> None:
        """Test edge cases with invalid inputs."""
        # Test with invalid bearer token
        result = FlextAuthUtilities.TokenValidation.validate_bearer_token("")
        assert result.is_failure

        # Test with invalid API key - should fail for empty key
        valid_keys = {"key1", "key2"}
        result = FlextAuthUtilities.TokenValidation.validate_api_key("", valid_keys)
        assert result.is_failure  # This should fail for empty API key

    def test_constants_usage(self) -> None:
        """Test that utilities properly use FlextAuthConstants."""
        utilities = FlextAuthUtilities()
        # This tests that the utilities can be instantiated and use constants
        assert utilities is not None

        # Test that constants are accessible through the utilities
        result = utilities.execute()
        assert result.is_success

    def test_utilities_properties(self) -> None:
        """Test utilities properties."""
        utilities = FlextAuthUtilities()

        # Test logger property (it's a property, not a method)
        logger = utilities.logger
        assert logger is not None

        # Test container property (it's a property, not a method)
        container = utilities.container
        assert container is not None

    def test_password_utilities_edge_cases(self) -> None:
        """Test password utilities edge cases."""
        # Test with very short password - this should fail due to minimum length requirement
        result = FlextAuthUtilities.PasswordUtilities.generate_secure_password(4)
        assert result.is_failure  # Should fail because minimum length is 8

        # Test with very long password
        result = FlextAuthUtilities.PasswordUtilities.generate_secure_password(64)
        assert result.is_success
        assert len(result.data) == 64

    def test_oauth_helpers_edge_cases(self) -> None:
        """Test OAuth helpers edge cases."""
        # Test PKCE challenge with empty verifier - this actually succeeds and generates a challenge
        result = FlextAuthUtilities.OAuthHelpers.generate_pkce_challenge("")
        assert result.is_success  # This actually succeeds

        # Test state parameter validation with different states
        state1 = "state1"
        state2 = "state2"
        result = FlextAuthUtilities.OAuthHelpers.validate_state_parameter(
            state1, state2
        )
        assert result.is_success
        assert result.data is False  # Validation fails but method succeeds

    def test_jwt_processing_edge_cases(self) -> None:
        """Test JWT processing edge cases."""
        # Test with empty payload
        empty_payload: dict[str, Any] = {}
        secret = SecretStr("secret_key")

        result = FlextAuthUtilities.JWTProcessing.create_jwt_token(
            empty_payload, secret
        )
        assert result.is_success

        # Test with invalid token
        invalid_token = "invalid.token"
        result = FlextAuthUtilities.JWTProcessing.extract_claims(invalid_token, secret)
        assert result.is_failure
