from __future__ import annotations

from typing import Any

import pytest
from pydantic import SecretStr

from flext_auth.models import FlextAuthModels
from flext_auth.utilities import FlextAuthUtilities


class TestFlextAuthUtilitiesFinal:
    """Final corrected tests for FlextAuthUtilities class."""

    def test_utilities_initialization(self) -> None:
        """Test utilities initialization."""
        utilities = FlextAuthUtilities()
        assert utilities is not None
        assert hasattr(utilities, "_container")
        assert hasattr(utilities, "_logger")

    def test_utilities_execute(self) -> None:
        """Test utilities execute method."""
        utilities = FlextAuthUtilities()
        result = utilities.execute()

        assert result.is_success
        assert "capabilities" in result.data
        assert "status" in result.data

    @pytest.mark.io
    def test_utilities_execute(self) -> None:
        """Test utilities execute method."""
        utilities = FlextAuthUtilities()
        result = utilities.execute()

        assert result.is_success
        # The version returns different data structure
        assert "status" in result.data
        assert "service" in result.data

    def test_token_validation_validate_jwt_token(self) -> None:
        """Test JWT token validation."""
        token = "test.token.here"
        secret = SecretStr("secret_key")

        result = FlextAuthUtilities.TokenValidation.validate_jwt_token(token, secret)
        assert result is not None

    def test_token_validation_validate_bearer_token(self) -> None:
        """Test bearer token validation."""
        # Valid bearer token format
        result = FlextAuthUtilities.TokenValidation.validate_bearer_token(
            "Bearer valid_token"
        )
        assert result.is_success

        # Invalid bearer token format
        result = FlextAuthUtilities.TokenValidation.validate_bearer_token(
            "Invalid token"
        )
        assert result.is_failure

    def test_token_validation_validate_api_key(self) -> None:
        """Test API key validation."""
        valid_keys = {"key1", "key2", "key3"}

        # Valid API key
        result = FlextAuthUtilities.TokenValidation.validate_api_key("key1", valid_keys)
        assert result.is_success
        assert result.data is True

        # Invalid API key
        result = FlextAuthUtilities.TokenValidation.validate_api_key(
            "invalid_key", valid_keys
        )
        assert result.is_success
        assert result.data is False

    def test_jwt_processing_create_jwt_token(self) -> None:
        """Test JWT token creation."""
        payload: dict[str, str] = {"sub": "1234567890", "name": "John Doe"}
        secret = SecretStr("secret_key")

        result = FlextAuthUtilities.JWTProcessing.create_jwt_token(payload, secret)
        assert result.is_success
        # The result.data is the token string directly, not a dict
        assert isinstance(result.data, str)
        assert len(result.data) > 0

    def test_jwt_processing_refresh_jwt_token(self) -> None:
        """Test JWT token refresh."""
        # First create a token
        payload = {"sub": "1234567890"}
        secret = SecretStr("secret_key")

        create_result = FlextAuthUtilities.JWTProcessing.create_jwt_token(
            payload, secret
        )
        assert create_result.is_success

        token = create_result.data  # Direct string, not dict

        # Refresh the token
        result = FlextAuthUtilities.JWTProcessing.refresh_jwt_token(token, secret)
        assert result is not None

    def test_jwt_processing_extract_claims(self) -> None:
        """Test JWT claims extraction."""
        payload = {"sub": "1234567890", "name": "John Doe"}
        secret = SecretStr("secret_key")

        # First create a token
        create_result = FlextAuthUtilities.JWTProcessing.create_jwt_token(
            payload, secret
        )
        assert create_result.is_success

        token = create_result.data  # Direct string, not dict

        # Extract claims
        result = FlextAuthUtilities.JWTProcessing.extract_claims(token, secret)
        assert result is not None

    def test_oauth_helpers_generate_state_parameter(self) -> None:
        """Test OAuth state parameter generation."""
        result = FlextAuthUtilities.OAuthHelpers.generate_state_parameter()
        assert result.is_success
        # The result.data is the state string directly, not a dict
        assert isinstance(result.data, str)
        assert len(result.data) > 0

    def test_oauth_helpers_validate_state_parameter(self) -> None:
        """Test OAuth state parameter validation."""
        # Generate a state parameter
        state_result = FlextAuthUtilities.OAuthHelpers.generate_state_parameter()
        assert state_result.is_success

        state = state_result.data

        # Validate the state parameter
        result = FlextAuthUtilities.OAuthHelpers.validate_state_parameter(state, state)
        assert result.is_success

    def test_oauth_helpers_generate_pkce_verifier(self) -> None:
        """Test PKCE verifier generation."""
        result = FlextAuthUtilities.OAuthHelpers.generate_pkce_verifier()
        assert result.is_success
        assert isinstance(result.data, str)
        assert len(result.data) > 0

    def test_oauth_helpers_generate_pkce_challenge(self) -> None:
        """Test PKCE challenge generation."""
        # First generate a verifier
        verifier_result = FlextAuthUtilities.OAuthHelpers.generate_pkce_verifier()
        assert verifier_result.is_success

        verifier = verifier_result.data

        # Generate challenge
        result = FlextAuthUtilities.OAuthHelpers.generate_pkce_challenge(verifier)
        assert result.is_success
        assert isinstance(result.data, str)

    def test_password_utilities_hash_password(self) -> None:
        """Test password hashing."""
        password = SecretStr("test_password")

        result = FlextAuthUtilities.PasswordUtilities.hash_password(password)
        assert result.is_success
        # The result.data is the hashed password string directly, not a dict
        assert isinstance(result.data, str)
        assert result.data != password.get_secret_value()

    def test_password_utilities_verify_password(self) -> None:
        """Test password verification."""
        password = SecretStr("test_password")

        # First hash the password
        hash_result = FlextAuthUtilities.PasswordUtilities.hash_password(password)
        assert hash_result.is_success

        hashed_password = hash_result.data  # Direct string, not dict

        # Verify the password
        verify_result = FlextAuthUtilities.PasswordUtilities.verify_password(
            password, hashed_password
        )
        assert verify_result.is_success
        assert verify_result.data is True

        # Verify with wrong password
        wrong_password = SecretStr("wrong_password")
        wrong_result = FlextAuthUtilities.PasswordUtilities.verify_password(
            wrong_password, hashed_password
        )
        assert wrong_result.is_success
        assert wrong_result.data is False

    def test_password_utilities_generate_secure_password(self) -> None:
        """Test secure password generation."""
        result = FlextAuthUtilities.PasswordUtilities.generate_secure_password()
        assert result.is_success
        # The result.data is the password string directly, not a dict
        assert isinstance(result.data, str)
        assert len(result.data) >= 8

    def test_password_utilities_generate_password_with_length(self) -> None:
        """Test password generation with specific length."""
        length = 16
        result = FlextAuthUtilities.PasswordUtilities.generate_secure_password(length)
        assert result.is_success
        assert len(result.data) == length

    def test_password_utilities_validate_password_strength(self) -> None:
        """Test password strength validation."""
        # Strong password
        strong_password = SecretStr("MyStr0ng!P@ssw0rd")
        result = FlextAuthUtilities.PasswordUtilities.validate_password_strength(
            strong_password
        )
        assert result.is_success

        # Weak password
        weak_password = SecretStr("123")
        result = FlextAuthUtilities.PasswordUtilities.validate_password_strength(
            weak_password
        )
        assert result.is_success

    def test_password_utilities_hash_password_bcrypt(self) -> None:
        """Test bcrypt password hashing."""
        password = "test_password"

        result = FlextAuthUtilities.PasswordUtilities.hash_password_bcrypt(password)
        assert result.is_success
        assert isinstance(result.data, str)
        assert result.data != password

    def test_password_utilities_verify_password_bcrypt(self) -> None:
        """Test bcrypt password verification."""
        password = "test_password"

        # First hash the password
        hash_result = FlextAuthUtilities.PasswordUtilities.hash_password_bcrypt(
            password
        )
        assert hash_result.is_success

        hashed_password = hash_result.data

        # Verify the password
        verify_result = FlextAuthUtilities.PasswordUtilities.verify_password_bcrypt(
            password, hashed_password
        )
        assert verify_result.is_success
        assert verify_result.data is True

    def test_session_management_create_session_token(self) -> None:
        """Test session token creation."""
        result = FlextAuthUtilities.SessionManagement.create_session_token()
        assert result.is_success
        assert isinstance(result.data, str)
        assert len(result.data) > 0

    def test_session_management_create_session(self) -> None:
        """Test session creation."""
        user_id = "user123"

        result = FlextAuthUtilities.SessionManagement.create_session(user_id)
        assert result.is_success
        # The result.data is a Session object, not a dict
        assert hasattr(result.data, "id")
        assert hasattr(result.data, "user_id")
        assert result.data.user_id == user_id

    def test_session_management_refresh_session(self) -> None:
        """Test session refresh."""
        # Create a user for the session
        user = FlextAuthModels.User(
            id="user123",
            username="testuser",
            email="test@example.com",
            roles=["user"],
            full_name="Test User",
            is_active=True,
            failed_login_attempts=0,
            locked_until=None,
            last_login=None,
        )

        # Create a session
        create_result = FlextAuthUtilities.SessionManagement.create_session(user.id)
        assert create_result.is_success

        session = create_result.data  # Session object, not dict

        # Refresh the session
        refresh_result = FlextAuthUtilities.SessionManagement.refresh_session(session)
        assert refresh_result.is_success

