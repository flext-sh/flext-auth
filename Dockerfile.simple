# Simple Docker validation for FLEXT Auth
FROM python:3.13-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
RUN pip install pydantic structlog bcrypt pyjwt python-multipart

# Copy flext-core source from parent directory
COPY ../flext-core/src/ ./flext-core-src/

# Copy flext-auth source and test
COPY src/ ./src/
COPY docker_test.py ./

# Add both to Python path
ENV PYTHONPATH=/app/src:/app/flext-core-src
CMD ["python", "docker_test.py"]